# Switch North Immigration V1 public website
# Required for V1 public marketing deployment:
NEXT_PUBLIC_SITE_URL=https://switchnorth.ca

# Optional for V1 contact and assessment emails.
# Use "disabled" locally. Use "resend" only when a verified sender and API key are configured.
EMAIL_PROVIDER=disabled
EMAIL_FROM=
LEAD_NOTIFICATION_TO=
RESEND_API_KEY=
CAPTCHA_SECRET_KEY=

# V1 feature flags. Keep these false for the public website launch.
NEXT_PUBLIC_FEATURE_APPOINTMENTS=false
FEATURE_APPOINTMENTS=false
FEATURE_PAYMENTS=false
FEATURE_AGREEMENT_PORTAL=false
FEATURE_ADMIN_PORTAL=false
FEATURE_APPOINTMENT_MANAGEMENT=false

# Future booking/payment/admin system variables.
# These are not required for V1 while the feature flags above remain disabled.
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
